@echo off
setlocal enabledelayedexpansion

set UEVR_COMMIT_HASH=unknown
FOR /F "tokens=*" %%g IN ('git rev-parse HEAD 2^>nul') DO (SET UEVR_COMMIT_HASH=%%g)

set UEVR_TAG=no_tag
FOR /F "tokens=*" %%t IN ('git describe --tags --abbrev^=0 2^>nul') DO (SET UEVR_TAG=%%t)
IF "%UEVR_TAG%"=="" (SET UEVR_TAG=no_tag)

set UEVR_TAG_LONG=%UEVR_TAG%
set UEVR_COMMITS_PAST_TAG=0
IF NOT "%UEVR_TAG%"=="no_tag" (
    FOR /F "tokens=*" %%n IN ('git rev-list "%UEVR_TAG%..HEAD" --count 2^>nul') DO (SET UEVR_COMMITS_PAST_TAG=%%n)
)
IF "%UEVR_COMMITS_PAST_TAG%"=="" (SET UEVR_COMMITS_PAST_TAG=0)

set UEVR_BRANCH=unknown
FOR /F "tokens=*" %%b IN ('git rev-parse --abbrev-ref HEAD 2^>nul') DO (SET UEVR_BRANCH=%%b)

set UEVR_TOTAL_COMMITS=0
FOR /F "tokens=*" %%n IN ('git rev-list --count HEAD 2^>nul') DO (SET UEVR_TOTAL_COMMITS=%%n)
IF "%UEVR_TOTAL_COMMITS%"=="" (SET UEVR_TOTAL_COMMITS=0)

IF EXIST "src\CommitHash.autogenerated" (
    findstr /C:"#define UEVR_COMMIT_HASH \"%UEVR_COMMIT_HASH%\"" "src\CommitHash.autogenerated" >nul 2>&1
    if !errorlevel! equ 0 (
        findstr /C:"#define UEVR_BRANCH \"%UEVR_BRANCH%\"" "src\CommitHash.autogenerated" >nul 2>&1
        if !errorlevel! equ 0 (
            echo src/CommitHash.autogenerated is up to date ^(%UEVR_COMMIT_HASH:~0,8%^).
            exit /b 0
        )
    )
)

SET year=
SET month=
SET day=
SET hour=
SET minute=

FOR /F "usebackq tokens=1-5 delims= " %%a IN (`powershell -NoProfile -Command "[Threading.Thread]::CurrentThread.CurrentCulture=[Globalization.CultureInfo]::InvariantCulture; Get-Date -Format 'yyyy MM dd HH mm'"`) DO (
SET year=%%a
SET month=%%b
SET day=%%c
SET hour=%%d
SET minute=%%e
)

IF "%year%"=="" (
echo WARNING: could not determine build date, powershell failed. Using placeholder.
SET year=0000
SET month=00
SET day=00
SET hour=00
SET minute=00
)

(
echo #pragma once
echo #define UEVR_COMMIT_HASH "%UEVR_COMMIT_HASH%"
echo #define UEVR_TAG "%UEVR_TAG%"
echo #define UEVR_TAG_LONG "%UEVR_TAG_LONG%"
echo #define UEVR_COMMITS_PAST_TAG %UEVR_COMMITS_PAST_TAG%
echo #define UEVR_BRANCH "%UEVR_BRANCH%"
echo #define UEVR_TOTAL_COMMITS %UEVR_TOTAL_COMMITS%
echo #define UEVR_BUILD_DATE "%day%.%month%.%year%"
echo #define UEVR_BUILD_TIME "%hour%:%minute%"
) > "src\CommitHash.autogenerated"

echo Updated src/CommitHash.autogenerated ^(%UEVR_COMMIT_HASH:~0,8%^).